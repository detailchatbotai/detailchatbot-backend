# Development Environment Configuration
# Copy this to .env for local development

# Application Settings
ENVIRONMENT=development
DEBUG=true

# Database (will be provided by Render for dev deployment)
# DATABASE_URL=postgresql://user:pass@host:5432/detailchatbot_dev

# Security (development keys - NEVER use in production)
SECRET_KEY=dev-secret-key-change-in-production-12345678901234567890
ALGORITHM=HS256

# OpenAI (you'll need to add your real key)
OPENAI_API_KEY=sk-proj-your-dev-openai-key-here
OPENAI_MODEL=gpt-3.5-turbo

# Stripe (use test keys for dev)
STRIPE_SECRET_KEY=sk_test_your-stripe-test-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-test-webhook-secret-here

# Email (optional for dev - can use mailtrap.io for testing)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_TLS=true

# Frontend (adjust based on your frontend dev server)
FRONTEND_URL=http://localhost:3000

# Development-friendly CORS
# Allows local development from multiple ports