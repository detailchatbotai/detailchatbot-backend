# Database Configuration (REQUIRED)
DATABASE_URL=postgresql://user:password@localhost:5432/detailchatbot

# Security Configuration (REQUIRED FOR PRODUCTION)
SECRET_KEY=your-256-bit-secret-key-here
ALGORITHM=HS256

# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-3.5-turbo

# Stripe Configuration (REQUIRED FOR SUBSCRIPTIONS)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here

# Email Configuration (REQUIRED FOR NOTIFICATIONS)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=SG.your-sendgrid-api-key-here
SMTP_TLS=true

# Application Configuration
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000

# Token Expiration (Optional - defaults provided)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_HOURS=24
MAGIC_LINK_EXPIRE_MINUTES=15

# Rate Limiting (Optional - defaults provided)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
LOGIN_RATE_LIMIT=5

# Security Headers (Optional - defaults provided)
ENABLE_SECURITY_HEADERS=true

# Password Requirements (Optional - defaults provided)
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true